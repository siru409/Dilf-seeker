(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r200_80
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 80000)
            (height 200000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r200_70
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 70000)
            (height 200000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c172.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 86250
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r200_80
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r200_80))
          (noconnect (pad r200_80))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r200_80))
          (noconnect (pad r200_80))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r200_80))
          (noconnect (pad r200_80))
        )
      )
      (padstack r200_70
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r200_70))
          (noconnect (pad r200_70))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r200_70))
          (noconnect (pad r200_70))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r200_70))
          (noconnect (pad r200_70))
        )
      )
      (padstack r200_70
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r200_70))
          (noconnect (pad r200_70))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r200_70))
          (noconnect (pad r200_70))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r200_70))
          (noconnect (pad r200_70))
        )
      )
      (padstack c172.5h115
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 57500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c172.5))
          (noconnect (pad c172.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c172.5))
          (noconnect (pad c172.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c172.5))
          (noconnect (pad c172.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c172.5))
          (connect (pad c172.5))
          (noconnect (pad c172.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c172.5))
          (noconnect (pad c172.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "24808031"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 618300 278000)
                    (pt 618300 -278000)
                    (pt -618300 -278000)
                    (pt -618300 278000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -270000 178000
                        (width 10000)
                      )
                      (pt 270000 178000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 270000 178000
                        (width 10000)
                      )
                      (pt 270000 178000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 178000)
                        (begin
                          (pt 270000 178000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt 270000 -178000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 178000)
                        (begin
                          (pt -270000 -178000
                            (width 10000)
                          )
                        )
                        (center -0 1073741824)
                        (end
                          (pt -270000 178000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -300000 -178000
                        (width 20000)
                      )
                      (pt 300000 -178000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin A5
            (pt -50000 78000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -50000 78000)
                  (angle 0)
                  (padstackGroup default (padstack r200_70))
                )
              )
            )
          )
          (pin A9
            (pt 150000 78000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 150000 78000)
                  (angle 0)
                  (padstackGroup default (padstack r200_80))
                )
              )
            )
          )
          (pin A12
            (pt 270000 78000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 270000 78000)
                  (angle 0)
                  (padstackGroup default (padstack r200_80))
                )
              )
            )
          )
          (pin B5
            (pt 50000 78000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 50000 78000)
                  (angle 0)
                  (padstackGroup default (padstack r200_70))
                )
              )
            )
          )
          (pin B9
            (pt -150000 78000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -150000 78000)
                  (angle 0)
                  (padstackGroup default (padstack r200_80))
                )
              )
            )
          )
          (pin B12
            (pt -270000 78000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -270000 78000)
                  (angle 0)
                  (padstackGroup default (padstack r200_80))
                )
              )
            )
          )
          (pin MH1
            (pt -432000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -432000 0)
                  (angle 90)
                  (padstackGroup default (padstack c172.5h115))
                )
              )
            )
          )
          (pin MH2
            (pt 432000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 432000 0)
                  (angle 90)
                  (padstackGroup default (padstack c172.5h115))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape 2480803-1.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

