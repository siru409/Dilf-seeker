                        (r 5000)
                        (begin
                          (pt -270000 0
                            (width 10000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt -260000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -171500 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -171500 0)
                  (angle 90)
                  (padstackGroup default (padstack r99_51))
                )
              )
