                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 321000 251000)
                    (pt 321000 -251000)
                    (pt -321000 -251000)
                    (pt -321000 251000)
