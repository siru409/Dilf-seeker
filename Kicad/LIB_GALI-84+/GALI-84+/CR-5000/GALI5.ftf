(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r149.9_71.1
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 71100)
            (height 149900)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r241.3_91.4
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 91400)
            (height 241300)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r292.1_190.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 190500)
            (height 292100)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r149.9_71.1
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r149.9_71.1))
          (noconnect (pad r149.9_71.1))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r149.9_71.1))
          (noconnect (pad r149.9_71.1))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r149.9_71.1))
          (noconnect (pad r149.9_71.1))
        )
      )
      (padstack r241.3_91.4
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r241.3_91.4))
          (noconnect (pad r241.3_91.4))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r241.3_91.4))
          (noconnect (pad r241.3_91.4))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r241.3_91.4))
          (noconnect (pad r241.3_91.4))
        )
      )
      (padstack r292.1_190.5
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r292.1_190.5))
          (noconnect (pad r292.1_190.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r292.1_190.5))
          (noconnect (pad r292.1_190.5))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r292.1_190.5))
          (noconnect (pad r292.1_190.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "GALI5"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 122000
                        (width 10000)
                      )
                      (pt 224800 122000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 122000
                        (width 10000)
                      )
                      (pt 224800 -122000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 -122000
                        (width 10000)
                      )
                      (pt -224800 -122000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 -122000
                        (width 10000)
                      )
                      (pt -224800 122000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 324800 402300)
                    (pt 324800 -331100)
                    (pt -324800 -331100)
                    (pt -324800 402300)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -140000 122000
                        (width 20000)
                      )
                      (pt -224800 120000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 120000
                        (width 20000)
                      )
                      (pt -224800 -122000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 140000 122000
                        (width 20000)
                      )
                      (pt 224800 120000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 120000
                        (width 20000)
                      )
                      (pt 224800 -120000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -149900 -280000
                        (width 10000)
                      )
                      (pt -149900 -280000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -149900 -280000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt -149900 -270000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -149900 -270000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt -149900 -280000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -149900 -156200)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -149900 -156200)
                  (angle 0)
                  (padstackGroup default (padstack r149.9_71.1))
                )
              )
            )
          )
          (pin 2
            (pt 0 -110500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -110500)
                  (angle 0)
                  (padstackGroup default (padstack r241.3_91.4))
                )
              )
            )
          )
          (pin 3
            (pt 149900 -156200)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 149900 -156200)
                  (angle 0)
                  (padstackGroup default (padstack r149.9_71.1))
                )
              )
            )
          )
          (pin 4
            (pt 0 156200)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 156200)
                  (angle 0)
                  (padstackGroup default (padstack r292.1_190.5))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape GALI-84+.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

