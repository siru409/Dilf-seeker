(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r177.8_101.6
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 101600)
            (height 177800)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c127
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 63500
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r177.8_101.6
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
      )
      (padstack r177.8_101.6
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
      )
      (padstack r177.8_101.6
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r177.8_101.6))
          (noconnect (pad r177.8_101.6))
        )
      )
      (padstack c127h254
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 127000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c127))
          (noconnect (pad c127))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c127))
          (noconnect (pad c127))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c127))
          (noconnect (pad c127))
        )
        (padSet (footLayer Inner)
          (clearance (pad c127))
          (connect (pad c127))
          (noconnect (pad c127))
        )
        (padSet (footLayer Bottom)
          (connect (pad c127))
          (noconnect (pad c127))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "ERA3"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 460700 460700)
                    (pt 460700 -460700)
                    (pt -460700 -460700)
                    (pt -460700 460700)
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -108000 0
                        (width 10000)
                      )
                      (pt -108000 0
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 108000)
                        (begin
                          (pt -108000 0
                            (width 10000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt 108000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 108000)
                        (begin
                          (pt 108000 0
                            (width 10000)
                          )
                        )
                        (center -1073741824 0)
                        (end
                          (pt -108000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 0 -420000
                        (width 10000)
                      )
                      (pt 0 -420000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 -420000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt 0 -410000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 -410000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt 0 -420000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 -420000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt 0 -410000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 0 -271800)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -271800)
                  (angle 0)
                  (padstackGroup default (padstack r177.8_101.6))
                )
              )
            )
          )
          (pin 2
            (pt 271800 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 271800 0)
                  (angle 90)
                  (padstackGroup default (padstack r177.8_101.6))
                )
              )
            )
          )
          (pin 3
            (pt 0 271800)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 271800)
                  (angle 0)
                  (padstackGroup default (padstack r177.8_101.6))
                )
              )
            )
          )
          (pin 4
            (pt -271800 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -271800 0)
                  (angle 90)
                  (padstackGroup default (padstack r177.8_101.6))
                )
              )
            )
          )
          (pin 5
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack c127h254))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape ERA-3+.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

